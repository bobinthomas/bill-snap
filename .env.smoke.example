# Local Supabase smoke env (SCAFFOLDING_PLAN.md §7). Copy to .env.smoke (gitignored).
#
# Local (Docker):  npx supabase start  →  npx supabase db reset  →  npx supabase status
#   fill SUPABASE_URL with the "API URL" and SUPABASE_SERVICE_ROLE_KEY with the
#   "service_role" key from `supabase status`.
# Hosted project:  npx supabase link --project-ref <ref> && npx supabase db push
#   then use https://<ref>.supabase.co + the project's service_role key.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set GEMINI_API_KEY to run the real Gemini extractor instead of the
# regex fallback (the smoke photo is fixture bytes, so Gemini will fail → fallback).
# GEMINI_API_KEY=
