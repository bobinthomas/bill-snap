# BillSnap secrets (SCAFFOLDING_PLAN.md §3)
# Local dev: copy to .dev.vars (gitignored). Production: `wrangler secret put <NAME>`.

# WhatsApp Cloud API (§7.2)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Gemini flash tier (§5.3) — the primary image extractor.
GEMINI_API_KEY=
# Model name; defaults to the current flash alias. Pin it (e.g.
# GEMINI_MODEL=gemini-2.5-flash-001) for reproducible eval baselines.
# GEMINI_MODEL=gemini-flash-latest
# Local only — deterministic mock extractor (no API quota needed) so the demo's
# auto-log path and invoice/ABN columns light up without a key. Overrides the
# real key while set; never enable in production.
# GEMINI_MOCK=true

# Supabase (§5.5, §7.3) — service-role key is server-side only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local only — enables the /dev/demo browser console (simulated WhatsApp).
# Never set this in production: the demo routes 404 without it.
# DEV_DEMO=true

# Configurable (non-secret) extraction thresholds (§5.4) and TTLs (§5.6/§5.8).
# Defaults live in src/config.ts; override here to tune without a deploy.
# EXTRACTION_AMOUNT_HIGH=0.90
# EXTRACTION_AMOUNT_LOW=0.70
# EXTRACTION_DATE_HIGH=0.85
# EXTRACTION_DATE_LOW=0.60
# EXTRACTION_VENDOR_HIGH=0.75
# EXTRACTION_VENDOR_LOW=0.50
# DRAFT_TTL_MINUTES=10
# NUDGE_DELAY_MINUTES=6
# UNDO_AUTO_LOG_HOURS=24
# UNDO_CONFIRM_MINUTES=5
