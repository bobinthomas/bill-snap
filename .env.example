[TEMPLATE]
# BillSnap secrets (SCAFFOLDING_PLAN.md §3)
# Local dev: copy to .dev.vars (gitignored). Production: `wrangler secret put <NAME>`.

# WhatsApp Cloud API (§7.2) — needed for the real webhook. The browser demo and
# /health tolerate missing values; the flows that use them fail at runtime.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Workers AI fallback parser (§5.3) — served by the native env.AI binding in
# wrangler.toml; no key lives here. These override the code defaults per
# workspace (text fallback over OCR text; LLaVA vision over photo bytes).
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf

# Local only — deterministic mock AI extractor (no Workers AI quota needed) so
# the demo's auto-log path and invoice/ABN columns light up without the binding.
# Overrides the real binding while set; never enable in production.
# GEMINI_MOCK=true

# Supabase (§5.5, §7.3) — service-role key is server-side only. Required for
# the real stores and `npm run smoke`; the browser demo runs in-memory without it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local only — enables the /dev/demo browser console (simulated WhatsApp).
# Never set this in production: the demo routes 404 without it.
# DEV_DEMO=true

# Configurable (non-secret) extraction thresholds (§5.4) and TTLs (§5.6/§5.8).
# Defaults live in src/config.ts; override here to tune without a deploy.
# EXTRACTION_AMOUNT_HIGH=0.90
# EXTRACTION_AMOUNT_LOW=0.70
# EXTRACTION_DATE_HIGH=0.85
# EXTRACTION_DATE_LOW=0.60
# EXTRACTION_VENDOR_HIGH=0.75
# EXTRACTION_VENDOR_LOW=0.50
# DRAFT_TTL_MINUTES=10
# NUDGE_DELAY_MINUTES=6
# UNDO_AUTO_LOG_HOURS=24
# UNDO_CONFIRM_MINUTES=5
