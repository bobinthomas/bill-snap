{
  "name": "bill-snap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:full": "node scripts/dev-bootstrap.mjs",
    "dev:down": "node scripts/dev-teardown.mjs",
    "deploy": "wrangler deploy -c wrangler.deploy.toml",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run tests/smoke.test.ts",
    "db:seed": "wrangler d1 execute bill-snap --local --file=d1/seed.sql",
    "db:seed:remote": "wrangler d1 execute bill-snap --remote --file=d1/seed.sql",
    "eval": "vitest run --config vitest.eval.config.ts eval/harness.run.ts",
    "sweep": "vitest run --config vitest.eval.config.ts eval/sweep.run.ts",
    "eval:ocr": "vitest run --config vitest.eval.config.ts eval/ocr.run.ts"
  },
  "dependencies": {
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@napi-rs/canvas": "^1.0.6",
    "@types/node": "^26.2.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
